BASE_URL=value
NOTION_ACCESS_TOKEN=value
NOTION_DATABASE_CONTENT_ID=value
NOTION_PAGE_HOME_ID=value
NOTION_PAGE_ABOUT_ID=value
NOTION_PAGE_WORK_ID=value
NOTION_PAGE_BLOG_ID=value
# Optional, development only: page rendered at /dev/blocks
NOTION_PAGE_PLAYGROUND_ID=value
REVALIDATION_SECRET=value
# Optional: rich_text property name on the content DB (exact URL slug per row). When set, slug lookups use one filtered query instead of scanning pages.
# NOTION_SLUG_PROPERTY=Slug
# Optional: hosts whose Notion embeds load live in a sandboxed iframe (subdomains included). Others render as preview cards.
NOTION_EMBED_HOSTS=figma.com,sanding.space

# Supabase (nublson project) — used server-side only for reactions, view counts + speech-mode audio
# Dashboard: https://supabase.com/dashboard/project/ubwmngcqwvdvcyprcdmf
# Schema migrations: pnpm supabase:login && pnpm supabase:link && pnpm supabase:db:push (see supabase/README.md)
NEXT_PUBLIC_SUPABASE_URL=value
SUPABASE_SERVICE_ROLE_KEY=value
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=value

# Speech mode — OpenAI TTS (gpt-4o-mini-tts) for per-post narration (Ogg Opus)
OPENAI_API_KEY=value
# Optional: override the OpenAI speech endpoint (e.g. an OpenAI-compatible proxy). Defaults to OpenAI's own API.
# OPENAI_SPEECH_URL=https://api.openai.com/v1/audio/speech

# Purl — "Save with Purl" saves to the visitor's own account (browser-side OAuth + PKCE, no secret)
NEXT_PUBLIC_PURL_URL=https://purl.live
NEXT_PUBLIC_PURL_CLIENT_ID=

# Reactions — IP-based cross-browser dedup
# Any random secret string; used to hash visitor IPs before storing them
IP_HASH_SECRET=value