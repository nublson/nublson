{
  "openapi": "3.0.0",
  "info": {
    "title": "nublson.com content API",
    "version": "1.0"
  },
  "paths": {
    "/api/markdown/blog/{slug}": {
      "get": {
        "summary": "Blog post as markdown",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Markdown representation of a blog post"
          },
          "404": {
            "description": "Post not found"
          }
        }
      }
    },
    "/api/markdown/work/{slug}": {
      "get": {
        "summary": "Work post as markdown",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Markdown representation of a work case study"
          },
          "404": {
            "description": "Post not found"
          }
        }
      }
    }
  }
}
